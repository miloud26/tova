# Hashed build assets and images never change in place: cache them for a year
# so repeat visitors (and returning ad traffic) load instantly.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/static/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell is small and must stay fresh so new builds are picked up.
/*
  Cache-Control: public, max-age=0, must-revalidate
